generator client {
  provider = "prisma-client-js"
  output   = "../../../../node_modules/@bus/payment-prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  APPROVED
  FAILED
}

/// Saga orquestrada de checkout (Payment é o orquestrador).
enum CheckoutSagaStatus {
  STARTED
  PAYMENT_WINDOW_OPEN
  WAITING_WEBHOOK
  CHARGED
  COMPLETED
  COMPENSATING
  COMPENSATED
  FAILED
}

model Payment {
  id             String        @id @default(cuid())
  reservationId  String
  amountCents    Int
  status         PaymentStatus @default(PENDING)
  transactionId  String?
  idempotencyKey String        @unique
  failureReason  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([reservationId])
  @@index([status])
}

model CheckoutSaga {
  id             String             @id @default(cuid())
  reservationId  String
  idempotencyKey String             @unique
  paymentId      String?
  status         CheckoutSagaStatus @default(STARTED)
  failureReason  String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([reservationId])
  @@index([status])
}

/// Outbox transacional: payment.* na mesma tx do estado.
model OutboxEvent {
  id          String    @id @default(cuid())
  routingKey  String
  payload     Json
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  poisonedAt  DateTime?

  @@index([publishedAt, createdAt])
  @@index([poisonedAt, createdAt])
  @@map("PaymentOutboxEvent")
}

/// Dedupe de webhooks do PSP (providerEventId único).
model PspWebhookEvent {
  providerEventId String   @id
  provider        String   @default("mock")
  paymentId       String
  status          String
  payload         Json
  processedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([paymentId])
}
